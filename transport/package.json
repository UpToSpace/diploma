{
  "name": "transport",
  "version": "1.0.0",
  "description": "An application that allows to use public transport in Minsk city",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "server": "nodemon app.js --ignore client",
    "client": "npm run start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "author": "Valerie",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "config": "^3.3.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "express-validator": "^6.15.0",
    "fs": "^0.0.1-security",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.2",
    "nodemailer": "^6.9.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "react-hook-form": "^7.43.8",
    "react-hot-toast": "^2.4.1",
    "stripe": "^14.23.0",
    "util": "^0.12.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.21"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
